# 배포 환경 설정. 이 파일을 .env로 복사해 채우세요.
#
#   cp .env.example .env
#
# .env는 .gitignore에 있습니다. 비밀값을 config/*.json에 넣지 마세요 —
# 그쪽은 git에 커밋됩니다.
#
# config JSON과 축이 다릅니다:
#   config JSON : GBM/FCT별로 갈림 (임계치, on/off, 템플릿)  → 커밋됨
#   .env        : 배포 환경별로 갈림 (주소, 계정, 비밀번호)    → 커밋 안 됨
#
# 지금은 전부 스텁이라 비워둬도 동작합니다.

# ── 배포 좌표 ──────────────────────────────────────────────
# 이 프로세스가 어떤 GBM/FCT로 뜰지. CLI의 --gbm/--factory가 우선합니다.
DEPLOY_GBM=mx
DEPLOY_FACTORY=gumi

# ── Redis (생산정보·라인정보·장비상태) ──────────────────────
REDIS_URL=redis://redis.internal:6379/0
REDIS_PWD=

# ── MongoDB (알람 이력 + 체크포인터) ────────────────────────
MONGODB_URI=mongodb://mongo.internal:27017
MONGODB_PWD=
MONGODB_DB=mes
CHECKPOINT_DB=langgraph

# ── Kafka (오프셋 메타데이터만. 메시지 소비 안 함) ──────────
KAFKA_BOOTSTRAP_SERVERS=kafka1.internal:9092,kafka2.internal:9092
KAFKA_USER=
KAFKA_PWD=

# ── REST API (KPI) ────────────────────────────────────────
REST_BASE_URL=https://mes-api.internal
REST_API_TOKEN=

# ── LLM ───────────────────────────────────────────────────
# 사내 게이트웨이가 OpenAI 호환이면 base_url 교체만으로 공급자가 바뀝니다.
# model/temperature는 GBM/FCT별로 다를 수 있어 config JSON에 있습니다.
LLM_BASE_URL=http://llm-gateway.internal/v1
LLM_API_KEY=

# ── 메일 발송 ──────────────────────────────────────────────
# 수신자 목록은 GBM/FCT별로 다르므로 config JSON의 delivery.mail.recipients에 있습니다.
SMTP_HOST=smtp.internal
SMTP_PORT=25
SMTP_USER=
SMTP_PWD=
SMTP_SENDER=mes-report@example.com
